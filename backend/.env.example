# Local development only. Copy this file to .env and set values for your local MySQL instance.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=portal_accounting
# Set to true only for the local dummy database. Never enable in production.
DB_SYNCHRONIZE=true

# Replace this with a long, unique value before using anything beyond local development.
JWT_SECRET=replace-with-a-long-local-development-secret

# A local dummy administrator is created only when the users table is empty.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@pvhai.local
SEED_ADMIN_PASSWORD=ChangeMe123!
